<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Родитель Spring Boot: задаёт версии всех стандартных зависимостей -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.3</version>
        <relativePath/>
    </parent>

    <groupId>ru.dit.heattracer</groupId>
    <artifactId>heat-tracer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>heat-tracer</name>
    <description>Сервис моделирования трасс подключения к тепловым сетям</description>

    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Версии сторонних библиотек -->
        <jts.version>1.19.0</jts.version>
        <proj4j.version>1.2.2</proj4j.version>
        <jgrapht.version>1.5.3</jgrapht.version>
        <springdoc.version>1.7.0</springdoc.version>

        <!-- Testcontainers 1.20.x = docker-java 3.4.x: последний ряд, работающий с Java 11
             (Testcontainers 1.21+/docker-java 3.5+ требуют Java 17). -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <!-- Ключевой фикс конфликта версий: spring-boot-starter-parent 2.6.3 управляет Jackson 2.13.1,
             который слишком стар для docker-java 3.4.x и некорректно выполняет API-negotiation
             с Docker Engine 27+ (400 Bad Request на /v1.32/info -> ExceptionInInitializerError).
             Поднимаем Jackson до актуальной ветки 2.18.x через BOM. -->
        <jackson-bom.version>2.18.4</jackson-bom.version>
    </properties>

    <!-- ============ dependencyManagement ============
         1) Testcontainers BOM — единая согласованная версия всех артефактов testcontainers
            и транзитивного docker-java. Раньше версии фиксировались вручную по отдельности,
            из-за чего возникали конфликты (транспорт, несовместимый с Docker Engine 27+).
         2) Jackson BOM — переопределяет управляемую spring-boot-starter-parent версию 2.13.1:
            docker-java 3.5.x требует Jackson >= 2.14, иначе negotiation API-версии с Docker
            Desktop 4.35+/Engine 29 падает с "400 Bad Request" -> ExceptionInInitializerError.
            dependencyManagement проекта имеет приоритет над managed-зависимостями parent. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============ Spring Boot ============ -->
        <!-- REST API (Spring MVC, Jackson, Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Валидация входных DTO (@Valid, @NotNull и т.п.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============ Документация API ============ -->

        <!-- Swagger UI для Spring Boot 2.6.x (версия управляется свойством springdoc.version) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============ Геометрия ============ -->

        <!-- JTS Topology Suite: геометрические операции, STRtree, буферы -->
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>${jts.version}</version>
        </dependency>

        <!-- JTS IO: WKBReader, WKTWriter для сериализации геометрий -->
        <dependency>
            <groupId>org.locationtech.jts.io</groupId>
            <artifactId>jts-io-common</artifactId>
            <version>${jts.version}</version>
        </dependency>

        <!-- proj4j: преобразование координат EPSG:4326 <-> EPSG:32637 -->
        <dependency>
            <groupId>org.locationtech.proj4j</groupId>
            <artifactId>proj4j</artifactId>
            <version>${proj4j.version}</version>
        </dependency>

        <!-- proj4j-epsg: база данных проекций EPSG -->
        <dependency>
            <groupId>org.locationtech.proj4j</groupId>
            <artifactId>proj4j-epsg</artifactId>
            <version>${proj4j.version}</version>
        </dependency>

        <!-- ============ Графы ============ -->

        <!-- JGraphT: A*, Dijkstra, MST, Steiner tree -->
        <dependency>
            <groupId>org.jgrapht</groupId>
            <artifactId>jgrapht-core</artifactId>
            <version>${jgrapht.version}</version>
        </dependency>

        <!-- ============ Тесты ============ -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers для интеграционных тестов с PostgreSQL (версии — из BOM в dependencyManagement) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Spring JDBC: JdbcTemplate, DataSource, транзакции -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- ============ Утилиты ============ -->

        <!-- Lombok: автоматическая генерация геттеров, сеттеров, конструкторов -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.24</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Не обрезать стектрейсы: иначе причина ExceptionInInitializerError не видна -->
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <!-- Плагин Spring Boot: позволяет запускать приложение как java -jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Maven Enforcer: ловит конфликты версий ДО падения тестов.
                 Maven сам по себе молча выбирает "победителя" по nearest-wins —
                 именно так Jackson 2.13 из Spring Boot тихо перебивал нужную
                 docker-java версию. Эти правила делают такие ситуации сборочной ошибкой. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[11,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.0,)</version>
                                </requireMavenVersion>
                                <!-- запрещённые (заведомо несовместимые) версии -->
                                <bannedDependencies>
                                    <excludes>
                                        <!-- docker-java < 3.4 не работает с Docker Engine 27+ (400 Bad Request) -->
                                        <exclude>com.github.docker-java:*:[0,3.4)</exclude>
                                        <!-- testcontainers < 1.20 тянет старый docker-java -->
                                        <exclude>org.testcontainers:*:[0,1.20)</exclude>
                                        <!-- Jackson < 2.14 несовместим с docker-java 3.4.x (битый API-negotiation) -->
                                        <exclude>com.fasterxml.jackson.core:jackson-databind:[0,2.14)</exclude>
                                    </excludes>
                                </bannedDependencies>
                                <!-- единая версия артефакта во всём дереве (ловит nearest-wins конфликты) -->
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>